generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusReserva {
  APROVADA
  PENDENTE
  CANCELADA
}

enum StatusSala {
  LIVRE //Sala livre (Sem reserva)
  OCUPADA //Sala ocupada (Com reserva)
  MANUTENCAO //Sala em manutenção
  DESATIVADA //Sala desativada
}

enum Cargo {
  ADMINISTRADOR //Controle total na aplicação.
  ATENDIMENTO //Equipe de postos, responsável por validar e aceitar as reservas.
  MINISTRANTE //Ministrante das aulas, pode realizar reservas.
  FUNCIONARIO //Qualquer funcionário, terá acesso a realizar reservas.
}

enum TipoReserva {
  ESPORADICA //Reservas que são esporádicas, não ocorrem durante todo o semestre
  RECORRENTE //Reservas recorrentes que ocorrem todo o semestre, geralmente aulas
}

enum TipoEvento {
  AULA //Evento pode ser uma aula
  PALESTRA //Evento pode ser palestra
  BANCA //Evento pode ser banca
  REUNIAO //Evento pode ser uma reunião
  EVENTO //Evento de pessoas externas
}

enum TipoMobiliario {
  MESADESENHO
  CADEIRABRACO
  MESAREUNIAO
  MOBILIARIOMOVEL
}

enum TipoEquipamento {
  CAIXASOM
  PROJETOR
  COMPUTADOR
  MICROFONE
  WEBCAM
}

model Usuario {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome           String
  sobrenome      String
  email          String   @unique
  telefone       String   @default("(xx)xxxxx-xxxx")
  dataNascimento DateTime @db.Date
  senha          String
  cargos         Cargo[]

  Turmas             Turma[] //Turmas que o ministrante está ligado
  TurmaAlunos        TurmaAluno[]
  ReservaMinistrante Reserva[]    @relation("ReservaMinistrante")
  ReservaSolicitante Reserva[]    @relation("ReservaSolicitante")
  ReservaAprovador   Reserva[]    @relation("ReservaAprovador")
}

model Setor {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String  @unique
  descricao String
  blocos    Bloco[]
}

model Bloco {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero  Int
  setorId String @db.Uuid
  setor   Setor  @relation(fields: [setorId], references: [id])
  salas   Sala[]
}

model Sala {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero            Int
  temAcessibilidade Boolean
  capacidade        Int
  blocoId           String     @db.Uuid
  statusSala        StatusSala @default(LIVRE)
  bloco             Bloco      @relation(fields: [blocoId], references: [id])

  Reservas     Reserva[]
  Equipamentos SalaEquipamento[]
  Mobiliarios  SalaMobiliario[]

  @@index([statusSala])
  @@index([blocoId, numero])
}

model SalaMobiliario {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salaId         String         @db.Uuid
  tipoMobiliario TipoMobiliario

  sala Sala @relation(fields: [salaId], references: [id])
}

model SalaEquipamento {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salaId          String          @db.Uuid
  tipoEquipamento TipoEquipamento

  sala Sala @relation(fields: [salaId], references: [id])
}

model Curso {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome String

  Turmas     Turma[]
  Curriculos Curriculo[]
}

model Curriculo {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versaoCurriculo Int
  cursoId         String @db.Uuid
  curso           Curso  @relation(fields: [cursoId], references: [id])

  disciplinas CurriculoDisciplina[]
}

model CurriculoDisciplina {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curriculoId  String  @db.Uuid
  disciplinaId String  @db.Uuid
  obrigatoria  Boolean
  semestre     Int

  curriculo  Curriculo  @relation(fields: [curriculoId], references: [id])
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id])

  @@unique([curriculoId, disciplinaId])
}

model Disciplina {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome           String
  numeroCreditos Int
  cargaHoraria   Int

  curriculos CurriculoDisciplina[]
  turmas     Turma[]
}

model Turma {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String
  vagas         Int     @default(40)
  cursoId       String  @db.Uuid
  disciplinaId  String  @db.Uuid
  ministranteId String? @db.Uuid

  curso       Curso      @relation(fields: [cursoId], references: [id])
  disciplina  Disciplina @relation(fields: [disciplinaId], references: [id])
  ministrante Usuario?   @relation(fields: [ministranteId], references: [id])

  alunos   TurmaAluno[]
  horarios TurmaHorario[]
  Reserva  Reserva[]
}

model TurmaAluno {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turmaId String @db.Uuid
  alunoId String @db.Uuid

  turma Turma   @relation(fields: [turmaId], references: [id])
  aluno Usuario @relation(fields: [alunoId], references: [id])

  @@unique([turmaId, alunoId])
}

model TurmaHorario {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turmaId   String @db.Uuid
  horarioId String @db.Uuid

  turma   Turma   @relation(fields: [turmaId], references: [id])
  horario Horario @relation(fields: [horarioId], references: [id])

  @@unique([turmaId, horarioId])
}

model Horario {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String
  horaInicio DateTime @db.Time
  horaFim    DateTime @db.Time

  reservas     Reserva[]
  TurmaHorario TurmaHorario[]
}

model Reserva {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipoReserva      TipoReserva
  tipoEvento       TipoEvento
  acessibilidade   Boolean
  diaSemana        Int
  dataInicio       DateTime    @db.Date
  dataFim          DateTime    @db.Date
  horarioId        String?     @db.Uuid
  horaInicial      DateTime    @db.Time
  horaFinal        DateTime    @db.Time
  salaId           String?     @db.Uuid
  turmaId          String?     @db.Uuid
  qtdPessoas       Int
  ministranteId    String      @db.Uuid
  solicitanteId    String      @db.Uuid
  aprovadorId      String      @db.Uuid
  statusReserva    StatusReserva
  equipamentos     TipoEquipamento[]
  mobiliarios      TipoMobiliario[]
  setorPreferidoId String?

  horario     Horario? @relation(fields: [horarioId], references: [id])
  sala        Sala?    @relation(fields: [salaId], references: [id])
  turma       Turma?  @relation(fields: [turmaId], references: [id])
  ministrante Usuario @relation("ReservaMinistrante", fields: [ministranteId], references: [id])
  solicitante Usuario @relation("ReservaSolicitante", fields: [solicitanteId], references: [id])
  aprovador   Usuario @relation("ReservaAprovador", fields: [aprovadorId], references: [id])
}
