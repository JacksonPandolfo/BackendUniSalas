generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusSala {
  LIVRE
  OCUPADA
  MANUTENCAO
  DESATIVADA
}

enum Cargo {
  ADMINISTRADOR //Controle total na aplicação.
  ATENDIMENTO   //Equipe de postos, responsável por validar e aceitar as reservas.
  MINISTRANTE     //Ministrante das aulas, pode realizar reservas.
  FUNCIONARIO   //Qualquer funcionário, terá acesso a realizar reservas.
}
enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

enum TipoReserva {
  ESPORADICA    //Reservas que são esporádicas, não ocorrem durante todo o semestre
  RECORRENTE    //Reservas recorrentes que ocorrem todo o semestre, geralmente aulas
}

enum TipoEvento {
  AULA
  PALESTRA
  BANCA
  REUNIAO
}

model Usuario {
  id              Int       @id @default(autoincrement())
  nome            String
  sobrenome       String
  email           String    @unique
  dataNascimento  DateTime
  cargos           Cargo     @default(FUNCIONARIO)

  Turma Turma[]
  TurmaAluno TurmaAluno[]
  ReservaMinistrante Reserva[] @relation("ReservaMinistrante")
  ReservaSolicitante Reserva[] @relation("ReservaSolicitante")
  ReservaAprovador Reserva[] @relation("ReservaAprovador")
}

model Setor {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  descricao String
  blocos    Bloco[]
  salas     Sala[]
}

model Bloco {
  id         Int      @id @default(autoincrement())
  numero     Int
  setorId    Int
  setor      Setor    @relation(fields: [setorId], references: [id])
  salas      Sala[]
}

model Sala {
  id                Int        @id @default(autoincrement())
  numero            Int
  statusSala        StatusSala @default(LIVRE)
  temAcessibilidade Boolean
  capacidade        Int
  setorId           Int
  blocoId           Int
  setor             Setor      @relation(fields: [setorId], references: [id])
  bloco             Bloco      @relation(fields: [blocoId], references: [id])

  @@index([statusSala])
  @@index([setorId, blocoId, numero])
  Reserva Reserva[]
}

model Curso{
  id Int @id @default(autoincrement())
  nome String
  disciplinas CursoDisciplina[]

  Turma Turma[]
}

model CursoDisciplina {
  id Int @id @default(autoincrement())
  cursoId Int
  disciplinaId Int

  curso Curso @relation(fields: [cursoId], references: [id])
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id])
  @@unique([cursoId, disciplinaId])
}

model Disciplina {
  id Int @id @default(autoincrement())
  nome String
  numeroCreditos Int
  cargaHoraria Int
  cursos CursoDisciplina[]

  Turma Turma[]
}

model Turma {
  id Int @id @default(autoincrement())
  vagas Int @default(40)
  cursoId Int
  disciplinaId Int
  ministranteId Int?

  curso Curso @relation(fields: [cursoId], references: [id])
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id])
  ministrante Usuario? @relation(fields: [ministranteId], references: [id])

  alunos TurmaAluno[]
  horarios TurmaHorario[]
  Reserva Reserva[]
}
model TurmaAluno {
  id       Int    @id @default(autoincrement())
  turmaId  Int
  alunoId  Int

  turma    Turma  @relation(fields: [turmaId], references: [id])
  aluno    Usuario @relation(fields: [alunoId], references: [id])

  @@unique([turmaId, alunoId])
}

model TurmaHorario {
  id        Int @id @default(autoincrement())
  turmaId   Int
  horarioId Int

  turma     Turma   @relation(fields: [turmaId], references: [id])
  horario   Horario @relation(fields: [horarioId], references: [id])

  @@unique([turmaId, horarioId])
}

model Horario {
  id Int @id @default(autoincrement())
  nome String
  horaInicio DateTime
  horaFim DateTime

  reservas Reserva[]
  TurmaHorario TurmaHorario[]
}

model Reserva {
  id Int @id @default(autoincrement())
  tipoReserva TipoReserva
  tipoEvento TipoEvento
  dataInicio DateTime
  dataFim DateTime
  diaSemana DiaSemana?
  horarioId Int
  salaId Int
  turmaId Int?
  ministranteId Int
  solicitanteId Int
  aprovadorId Int

  horario Horario @relation(fields: [horarioId], references: [id])
  sala Sala @relation(fields: [salaId], references: [id])
  turma Turma? @relation(fields: [turmaId], references: [id])
  ministrante Usuario @relation("ReservaMinistrante", fields: [ministranteId], references: [id])
  solicitante Usuario @relation("ReservaSolicitante", fields: [solicitanteId], references: [id])
  aprovador Usuario @relation("ReservaAprovador", fields: [aprovadorId], references: [id])
}